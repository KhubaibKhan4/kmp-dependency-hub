    {
      "id": "room",
      "name": "Room (KMP)",
      "category": "Database",
      "description": "Jetpack Room for Android, iOS and JVM with the bundled SQLite driver.",
      "website": "https://developer.android.com/kotlin/multiplatform/room",
      "platforms": [
        "ANDROID",
        "IOS",
        "JVM"
      ],
      "versions": {
        "room": "2.8.5",
        "sqlite": "2.7.1",
        "ksp": "2.3.12"
      },
      "artifacts": [
        {
          "alias": "androidx-room-runtime",
          "module": "androidx.room:room-runtime",
          "versionRef": "room"
        },
        {
          "alias": "androidx-sqlite-bundled",
          "module": "androidx.sqlite:sqlite-bundled",
          "versionRef": "sqlite"
        },
        {
          "alias": "androidx-room-compiler",
          "module": "androidx.room:room-compiler",
          "versionRef": "room",
          "configuration": "ksp"
        }
      ],
      "plugins": [
        {
          "alias": "ksp",
          "id": "com.google.devtools.ksp",
          "versionRef": "ksp"
        },
        {
          "alias": "androidx-room",
          "id": "androidx.room",
          "versionRef": "room"
        }
