      "id": "koin",
      "name": "Koin",
      "category": "Dependency Injection",
      "description": "Pragmatic DI with Compose and ViewModel integrations.",
      "website": "https://insert-koin.io/docs/reference/koin-mp/kmp",
      "platforms": [
        "ANDROID",
        "IOS",
        "JVM",
        "JS",
        "WASM",
