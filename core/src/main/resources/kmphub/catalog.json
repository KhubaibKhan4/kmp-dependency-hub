    {
      "id": "ktor-client",
      "name": "Ktor Client",
      "category": "Networking",
      "description": "HTTP client with per-platform engines and JSON content negotiation.",
      "website": "https://ktor.io/docs/client-create-multiplatform-application.html",
      "platforms": [
        "ANDROID",
        "IOS",
        "JVM",
        "JS",
        "WASM",
        "NATIVE"
      ],
      "versions": {
        "ktor": "3.6.0",
        "kotlin": "2.4.21"
      },
      "artifacts": [
        {
          "alias": "ktor-client-core",
          "module": "io.ktor:ktor-client-core",
          "versionRef": "ktor"
        },
        {
          "alias": "ktor-client-content-negotiation",
          "module": "io.ktor:ktor-client-content-negotiation",
          "versionRef": "ktor"
        },
        {
          "alias": "ktor-serialization-kotlinx-json",
          "module": "io.ktor:ktor-serialization-kotlinx-json",
          "versionRef": "ktor"
        },
        {
          "alias": "ktor-client-logging",
          "module": "io.ktor:ktor-client-logging",
          "versionRef": "ktor"
        },
        {
          "alias": "ktor-client-okhttp",
          "module": "io.ktor:ktor-client-okhttp",
          "versionRef": "ktor",
          "on": "android"
        },
        {
          "alias": "ktor-client-darwin",
          "module": "io.ktor:ktor-client-darwin",
          "versionRef": "ktor",
          "on": "ios"
        },
        {
          "alias": "ktor-client-java",
          "module": "io.ktor:ktor-client-java",
          "versionRef": "ktor",
          "on": "jvm"
        },
        {
          "alias": "ktor-client-js",
          "module": "io.ktor:ktor-client-js",
          "versionRef": "ktor",
          "on": "js"
        },
        {
          "alias": "ktor-client-js",
          "module": "io.ktor:ktor-client-js",
          "versionRef": "ktor",
          "on": "wasm"
        }
      ],
      "plugins": [
        {
          "alias": "kotlinx-serialization",
          "id": "org.jetbrains.kotlin.plugin.serialization",
          "versionRef": "kotlin"
        }
      ],
      "klibs": "ktorio/ktor"
    },
